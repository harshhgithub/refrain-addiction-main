{
    "manifest_version": 3,
    "name": "refrain-devices",
    "version": "0.0.1",
    "description": "Blocks distracting websites you selected in Refrain.",
    "permissions": ["declarativeNetRequest"],
    "host_permissions": ["<all_urls>"],
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "refrain_ruleset",
                "enabled": true,
                "path": "rules.json"
            }
        ]
    },
    "web_accessible_resources": [
        {
            "resources": ["blocked.html"],
            "matches": ["<all_urls>"]
        }
    ]
}